---
import Layout from '../layouts/BaseLayout.astro';
import c from '../../../catalog/generated/coverage.json';
import history from '../../../catalog/history.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = [
  [
    'Inventory coverage',
    c.inventory,
    c.inventory,
    'Records matching the pinned upstream inventory.',
  ],
  [
    'Example coverage',
    c.examples,
    c.inventory,
    'An inspectable example is present.',
  ],
  [
    'Detection coverage',
    c.detection,
    c.inventory,
    'A pinned Linguist classifier recognizes the example.',
  ],
  [
    'Validation coverage',
    c.validation,
    c.inventory,
    'The relevant core structural/content check passed.',
  ],
  [
    'Execution coverage',
    c.execution,
    c.inventory,
    'The program ran and produced its expected output.',
  ],
  [
    'Format validation',
    c.formats.validated,
    c.formats.total,
    'The curated sample passed its format check.',
  ],
  [
    'Platform demonstrations',
    c.features.demonstrated,
    c.features.total,
    'A hosted demonstration has recorded evidence.',
  ],
];
---

<Layout title="Coverage">
  <article class="detail wide">
    <p class="eyebrow">ACCOUNT FOR EVERYTHING. PROVE EACH CLAIM.</p>
    <h1>Coverage, without shortcuts.</h1>
    <p class="lead">One inventory. Several independent measures of progress.</p>
    <div class="coverage-table">
      {rows.map(([name, count, total, definition]) => (
        <div>
          <h2>{name}</h2>
          <p>{definition}</p>
          <strong>
            {count}
            <small> / {total}</small>
          </strong>
          <progress
            value={Number(count)}
            max={Number(total)}
            aria-label={String(name)}
          />
        </div>
      ))}
    </div>
    <section>
      <h2>Download the evidence</h2>
      <p>
        Reports describe this exact build. A missing tool or changed fingerprint
        cannot inherit a passing result.
      </p>
      <ul>
        {[
          'languages.json',
          'languages.csv',
          'formats.json',
          'features.json',
          'coverage.json',
          'evidence.json',
          'history.json',
          'SHA256SUMS',
        ].map((name) => (
          <li>
            <a href={`${base}/reports/${name}`}>{name}</a>
          </li>
        ))}
      </ul>
    </section>
    <section>
      <h2>Recorded progress</h2>
      <table>
        <thead>
          <tr>
            <th>Revision</th>
            <th>Examples</th>
            <th>Detected</th>
            <th>Executed</th>
            <th>Formats checked</th>
          </tr>
        </thead>
        <tbody>
          {history.map((h) => (
            <tr>
              <td>
                <a
                  href={`https://github.com/5675413-starfish-industries-5675413/github-showcase/commit/${h.revision}`}
                >
                  {h.revision.slice(0, 7)}
                </a>
              </td>
              <td>
                {h.examples}/{h.inventory}
              </td>
              <td>{h.detection}</td>
              <td>{h.execution}</td>
              <td>
                {h.formats.validated}/{h.formats.total}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>
        The current build’s counts appear above; history is retained only from
        actual verification runs.
      </p>
    </section>
    <section>
      <h2>The pinned baseline</h2>
      <p>
        GitHub Linguist revision{' '}
        <a href={`${c.baseline.repository}/tree/${c.baseline.revision}`}>
          <code>{c.baseline.revision}</code>
        </a>
      </p>
      <p>
        SHA-256: <code>{c.baseline.sha256}</code>
      </p>
      <div class="evidence-grid">
        {Object.entries(c.categories).map(([category, total]) => (
          <div>
            <span>{category}</span>
            <strong>{total}</strong>
          </div>
        ))}
      </div>
    </section>
    <section>
      <h2>How to read these numbers</h2>
      <p>
        Inventory completeness is not example completeness. Language statistics
        are not catalog coverage. Detection, compilation, content validation and
        execution have separate evidence. Three transcript entries have no
        automatic mapping in the pinned classifier; they require explicit
        language selection. Syntax and decoder checks remain limited to the
        included samples.
      </p>
      <p>
        Run <code>npm run verify</code> to validate the catalog, test failure
        cases, run the reviewed examples, build the site, and check internal
        links. Builds without matching evidence display “not tested.”
      </p>
    </section>
  </article>
</Layout>
