---
import '../styles/global.css';
const {
  title = 'Explore the collection',
  description = 'Small examples. Inspectable evidence. A searchable catalog of languages, formats, and GitHub workflows.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo =
  'https://github.com/5675413-starfish-industries-5675413/github-showcase';
const ref = import.meta.env.PUBLIC_SOURCE_REF || 'main';
const links = [
  ['Collection', '/'],
  ['Coverage', '/coverage/'],
  ['Walkthrough', '/walkthrough/'],
  ['About', '/about/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} — GitHub Showcase</title>
    <meta property="og:title" content={`${title} — GitHub Showcase`} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://5675413-starfish-industries-5675413.github.io/github-showcase/social-preview.png"
    />
    <link rel="icon" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header>
      <div class="header-inner">
        <a href={`${base}/`} class="brand">
          <span class="brand-icon" aria-hidden="true">
            &lt;/&gt;
          </span>
          GitHub Showcase<span class="version">v0.2</span>
        </a>
        <nav aria-label="Main navigation">
          {links.map(([label, url]) => (
            <a
              href={`${base}${url}`}
              aria-current={
                Astro.url.pathname === `${base}${url}` ? 'page' : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <a class="repo-link" href={repo}>
          Repository <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <span>
        <strong>GitHub Showcase</strong> · Independent, open source,
        inspectable.
      </span>
      <span>
        Not affiliated with GitHub.{' '}
        <a href={`${repo}/blob/${ref}/NOTICE.md`}>Attribution ↗</a>
      </span>
    </footer>
  </body>
</html>
